# Secrets — NEVER commit (Claude/API keys go here)
.env
.env.*
*.key
secrets/

# Local reports / generated output — keep the structure, ignore the contents.
reports/*
!reports/.gitkeep

# Python / uv
.venv/
venv/
__pycache__/
*.pyc
.python-version
uv.lock

# OS / editor
.DS_Store
.idea/
.vscode/

# Personal / non-public — durable containment. Do NOT rely on .git/info/exclude
# (it is per-clone and never travels); these belong in the committed .gitignore.
# Local-only working notes; keep the name neutral so the public ignore list carries
# no framing about what they contain.
ISA.md
CLAUDE.md
local-notes/
.lab/

# Brand/logo source assets — not part of the code (filed from _Inbox 2026-08-03)
assets/Iago-logo/

# Build-plan / design scratch — working artifacts, not shipped docs.
docs/*-plan.md

# Operator-supplied prompt-frame text for composed-evasion wrappers. The public tree
# ships only inert placeholder frames + the composition engine; real frame text stays local.
attacks/wrappers.local.yaml

# Operator-supplied fabricated-provenance frame text for provenance-forging. The public tree ships
# functional-but-mild default frames + the differential engine (so a clone reproduces a real
# finding); this optional file holds SHARPER operator history and stays local.
attacks/provenance.local.yaml

# Rendered ISA + checkpoint state — personal, never publish
ISA.html
.checkpoint-state.json
