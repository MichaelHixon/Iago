# Secrets — NEVER commit (Claude/API keys go here)
.env
.env.*
*.key
secrets/

# Local reports / generated output — keep the structure, ignore the contents.
reports/*
!reports/.gitkeep

# Python / uv
.venv/
venv/
__pycache__/
*.pyc
.python-version
uv.lock

# OS / editor
.DS_Store
.idea/
.vscode/

# Personal / non-public — durable containment. Do NOT rely on .git/info/exclude
# (it is per-clone and never travels); these belong in the committed .gitignore.
ISA.md
CLAUDE.md
interview-prep/
